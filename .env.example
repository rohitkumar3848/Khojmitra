# ========================================================
# KhojMitra (खोज-मित्र) - Production Environment Configuration
# ========================================================

# 1. MongoDB Database Connection
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/khojmitra
# For MongoDB Atlas (Production Cloud):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/khojmitra?retryWrites=true&w=majority

# 2. JWT Security Credentials (Min 256-bit base64 secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 3. Server Ports
PORT=8080
FRONTEND_PORT=5173

# 4. Business Logic Thresholds
QUIZ_PASSING_SCORE=3
REWARD_FINDER_PERCENTAGE=50
REWARD_PLATFORM_PERCENTAGE=50
GOODWILL_BONUS_POINTS=10

# 5. Docker Hub Credentials / Repositories
DOCKER_USERNAME=rohitkumar3848
DOCKER_BACKEND_IMAGE=rohitkumar3848/khojmitra-backend:latest
DOCKER_FRONTEND_IMAGE=rohitkumar3848/khojmitra-frontend:latest

# 6. GitHub Remote Repository
GITHUB_REPO_URL=https://github.com/rohitkumar3848/Khojmitra.git
